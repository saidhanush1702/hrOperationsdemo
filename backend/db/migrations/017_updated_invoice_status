-- 1. Disable constraints temporarily to allow clearing the lookup table
SET FOREIGN_KEY_CHECKS = 0;

-- 2. Map existing invoices to the new 1-5 ID system
-- Old 1 & 2 (Not Ready / Ready to Approve) -> New 1 (Draft)
UPDATE invoices SET status_id = 1 WHERE status_id IN (1, 2);
-- Old 3 (Ready to Invoice) -> New 2 (Ready to Send)
UPDATE invoices SET status_id = 2 WHERE status_id = 3;
-- Old 4 (Open) -> New 3 (Open)
UPDATE invoices SET status_id = 3 WHERE status_id = 4;
-- Old 5 (Past Due) -> New 4 (Past Due)
UPDATE invoices SET status_id = 4 WHERE status_id = 5;
-- Old 6 (Paid) -> New 5 (Paid)
UPDATE invoices SET status_id = 5 WHERE status_id = 6;

-- 3. Clear the old lookup table
TRUNCATE TABLE lkp_invoice_statuses;

-- 4. Insert the new strict 5 statuses
INSERT INTO lkp_invoice_statuses (id, name) VALUES 
(1, 'Draft'),
(2, 'Ready to Send'),
(3, 'Open'),
(4, 'Past Due'),
(5, 'Paid');

-- 5. Re-enable constraints
SET FOREIGN_KEY_CHECKS = 1;